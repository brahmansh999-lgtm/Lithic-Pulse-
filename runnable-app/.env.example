# Copy this file to `.env` and fill in your value. `.env` is gitignored.
#
# Google AI Studio (Gemini) API key — used by the AI-render backend to call
# gemini-3-pro-image-preview ("Nano Banana Pro") for structure-preserving
# room image editing.
#
#   1. Go to https://aistudio.google.com
#   2. Click "Get API key" -> create a key (no card needed for the free quota)
#   3. Paste it below (no quotes), save as `.env`, restart the dev server.
#
# No VITE_ prefix: this stays server-side only, never shipped to the browser.
GEMINI_API_KEY=
